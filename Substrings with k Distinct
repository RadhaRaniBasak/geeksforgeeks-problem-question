class Solution {
    public int countSubstr(String s, int k) {
        return countAtMost(s, k) - countAtMost(s, k - 1);
    }

    private int countAtMost(String s, int k) {
        int[] freq = new int[26];
        int unique = 0, count = 0, left = 0;

        for (int right = 0; right < s.length(); right++) {
            if (++freq[s.charAt(right) - 'a'] == 1) unique++;
            while (unique > k) {
                if (--freq[s.charAt(left) - 'a'] == 0) unique--;
                left++;
            }
            count += right - left + 1;
        }
        return count;
    }
}
