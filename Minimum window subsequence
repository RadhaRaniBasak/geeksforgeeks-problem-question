class Solution {
    public String minWindow(String s1, String s2) {
        int n = s1.length();
        int m = s2.length();
        String smallest = "";

        for (int i = 0; i < n; i++) {
            int p1 = i;
            int p2 = 0;

            while (p1 < n && p2 < m) {
                if (s1.charAt(p1) == s2.charAt(p2)) {
                    p2++;
                }
                p1++;
            }

            if (p2 == m) {
                if (smallest.isEmpty() || p1 - i < smallest.length()) {
                    smallest = s1.substring(i, p1);
                }
            }
        }

        return smallest;
    }
}
