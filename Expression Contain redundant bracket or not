class Solution {
    public static boolean checkRedundancy(String expression) {
        if (expression == null) {
            throw new NullPointerException("Input expression is null");
        }
        
        Stack<Character> stack = new Stack<>();
        
        for (int i = 0; i < expression.length(); i++) {
            char character = expression.charAt(i);
            if (character == ')') {
                boolean hasOperator = false;
                // Check if there are any operators inside the parentheses
                while (!stack.isEmpty() && stack.peek() != '(') {
                    char top = stack.pop();
                    if (top == '+' || top == '-' || top == '*' || top == '/') {
                        hasOperator = true;
                    }
                }
                // Remove the opening parenthesis
                stack.pop();
                if (!hasOperator) {
                    return true; // Redundant parentheses found
                }
            } else {
                stack.push(character);
            }
        }
        return false; // No redundant parentheses found
    }
}
